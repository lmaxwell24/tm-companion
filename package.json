{
  "name": "wpi-wave-av",
  "packageManager": "yarn@4.10.3",
  "version": "1.0.0",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "start": "node dist/index.js",
    "monitor": "nodemon --watch 'src/**/*.ts' --exec 'yarn build && yarn start' --ext ts",
    "watch": "tsc --watch",
    "build": "tsc",
    "dev": "concurrently \"yarn watch\" \"yarn monitor\"",
    "gen-env": "gen-env-types .env -o src/env.d.ts -e ."
  },
  "devDependencies": {
    "@types/dotenv-safe": "^9",
    "@types/node": "^24.9.2",
    "@types/typescript": "^2.0.0",
    "concurrently": "^9.2.1",
    "gen-env-types": "^1.3.4",
    "nodemon": "^3.1.10",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "dotenv": "^17.2.3",
    "dotenv-safe": "^9.1.0",
    "vex-tm-client": "^1.5.2"
  }
}
